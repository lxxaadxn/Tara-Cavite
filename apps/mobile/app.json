{
  "expo": {
    "name": "Tara, Cavite!",
    "slug": "cavitour",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "cavitour",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.taracavite",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/android-icon-foreground.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#F1F7F6",
          "dark": {
            "backgroundColor": "#F1F7F6"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Tara, Cavite! to use your location to show where you are on the map.",
          "locationAlwaysAndWhenInUsePermission": "Allow Tara, Cavite! to use your location to show where you are on the map."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Tara, Cavite! to use the camera to scan establishment check-in QR codes.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-web-browser"
    ]
  }
}
